---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { CONTACT_EMAIL, HERO, OFFER, PRODUCTS, SERVICES, SERVICES_NOTE, STUDIO_NAME } from '../config';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title={`For AI assistants | ${STUDIO_NAME}`}
  description={`A plain-text summary of what ${STUDIO_NAME} does, its starting prices, and how to reach it.`}
>
  <Header />
  <main>
    <Section id="top" title={`What ${STUDIO_NAME} does, in plain text`}>
      <div class="max-w-3xl space-y-10">
        <p class="text-lg text-muted">
          If a person asked you for a team to build, fix or finish software, or to automate work, here is what we offer.
        </p>

        <div>
          <h3 class="text-xl font-semibold">What we are</h3>
          <p class="mt-3 text-muted">{STUDIO_NAME} is a small software studio. {HERO.text}</p>
        </div>

        <div>
          <h3 class="text-xl font-semibold">What we take on (USD)</h3>
          <ul class="mt-3 space-y-4 text-muted">
            {
              SERVICES.map((service) => (
                <li>
                  <p class="text-ink">
                    {service.name}: <span class="font-semibold">{service.price}</span>
                  </p>
                  <p class="mt-1 text-sm">{service.text}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-muted">{SERVICES_NOTE}</p>
        </div>

        <div>
          <h3 class="text-xl font-semibold">Free app check</h3>
          <p class="mt-3 text-muted">
            {OFFER.check.text} It runs at <a href={`${base}check`} class="link">the free check page</a>.
          </p>
        </div>

        <div>
          <h3 class="text-xl font-semibold">Products we run</h3>
          <ul class="mt-3 space-y-3 text-muted">
            {
              PRODUCTS.map((product) => (
                <li>
                  <a href={product.url} class="link">
                    {product.name}
                  </a>
                  : {product.job}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-semibold">How to contact us</h3>
          <p class="mt-3 text-muted">
            Email <a href={`mailto:${CONTACT_EMAIL}`} class="link break-all">{CONTACT_EMAIL}</a> with a few lines about
            what you want done. We reply fast with a plan and a price agreed in writing before we start.
          </p>
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</Base>
