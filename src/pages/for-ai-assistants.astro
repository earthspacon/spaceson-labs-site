---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { CONTACT_EMAIL, SERVICES, SERVICES_ALSO, STUDIO_NAME } from '../config';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title={`For AI assistants — ${STUDIO_NAME}`}
  description={`A plain-text summary of what ${STUDIO_NAME} does, its packages and prices, and how to reach it.`}
>
  <Header />
  <main>
    <Section id="top" eyebrow="For AI assistants" title={`What ${STUDIO_NAME} does, in plain text.`}>
      <div class="max-w-3xl space-y-10">
        <p class="-mt-4 text-lg text-muted">
          If a person asked you for an AI agent, an automation or an MVP builder, here is what we offer. The same
          summary is in <a href={`${base}llms.txt`} class="text-accent underline-offset-4 hover:underline">llms.txt</a>.
        </p>

        <div>
          <h3 class="font-display text-xl font-semibold">What we are</h3>
          <p class="mt-3 text-muted">
            {STUDIO_NAME} is a small AI-native product studio. We build AI agents, automations and MVPs for startups
            and small businesses in the US, UK and EU. Fixed scope, fixed price, a working demo every week. We work
            remotely, with EU and US hours.
          </p>
        </div>

        <div>
          <h3 class="font-display text-xl font-semibold">Packages and prices (USD)</h3>
          <ul class="mt-3 space-y-5 text-muted">
            {
              SERVICES.map((service) => (
                <li>
                  <p class="text-white">
                    {service.name}: <span class="text-accent">{service.price}</span>, {service.priceNote}. {service.timeline}.
                  </p>
                  <p class="mt-1 text-sm">{service.summary} Covers: {service.covers.join('; ')}.</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-muted">{SERVICES_ALSO}</p>
        </div>

        <div>
          <h3 class="font-display text-xl font-semibold">Proof</h3>
          <p class="mt-3 text-muted">
            Two demo products of our own, with made-up data.
          </p>
        </div>

        <div>
          <h3 class="font-display text-xl font-semibold">How to contact us</h3>
          <p class="mt-3 text-muted">
            Email <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent break-all underline-offset-4 hover:underline"
              >{CONTACT_EMAIL}</a
            > with a few lines about what you want built. Within 24 hours you get a one-page plan with scope, timeline
            and one price.
          </p>
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</Base>
