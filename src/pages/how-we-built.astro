---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { BUILD_LOGS } from '../build-logs';
import { STUDIO_NAME } from '../config';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title={`How we built the demos — ${STUDIO_NAME}`}
  description="The briefs we gave an AI coding agent for our two demo products, condensed, with what actually happened."
>
  <Header />
  <main>
    <Section id="top" eyebrow="How we build" title="How it was built, brief by brief.">
      <p class="-mt-4 max-w-3xl text-lg text-muted">
        Our demos are built by an AI coding agent working from a written brief. Below are those briefs, shortened, and
        what came out. They are the specs we hand the agent, not a chat log. A senior engineer writes each brief and
        reviews the result.
      </p>
      <p class="mt-4 max-w-3xl text-sm text-muted">
        Both demos are our own products with made-up data. See them on the <a
          href={`${base}#work`}
          class="text-accent underline-offset-4 hover:underline">Work</a
        > section.
      </p>
    </Section>

    {
      BUILD_LOGS.map((log) => (
        <Section id={log.id} eyebrow="Demo" title={log.name}>
          <div class="grid gap-10 lg:grid-cols-5">
            <div class="space-y-8 lg:col-span-3">
              <div>
                <h3 class="font-display text-xl font-semibold">The brief: goal</h3>
                <p class="mt-3 text-muted">{log.goal}</p>
              </div>
              <div>
                <h3 class="font-display text-xl font-semibold">The brief: steps</h3>
                <ol class="mt-3 space-y-4 text-muted">
                  {log.steps.map((step, index) => (
                    <li class="flex gap-4">
                      <span class="font-display font-semibold text-accent">{index + 1}</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div>
                <h3 class="font-display text-xl font-semibold">The brief: rules</h3>
                <ul class="mt-3 space-y-2 text-muted">
                  {log.rules.map((rule) => (
                    <li class="flex gap-3">
                      <span class="text-accent" aria-hidden="true">
                        –
                      </span>
                      {rule}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <aside class="h-fit rounded-2xl border border-line bg-panel p-7 lg:col-span-2">
              <h3 class="font-display text-xl font-semibold">What happened</h3>
              <ul class="mt-4 space-y-4 text-sm text-white/85">
                {log.outcome.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-accent" aria-hidden="true">
                      ✓
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </aside>
          </div>
        </Section>
      ))
    }
  </main>
  <Footer />
</Base>
