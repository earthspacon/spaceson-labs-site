---
import { PROMPTING } from '../config';
import Section from './Section.astro';
---

<Section id="prompting" title={PROMPTING.title} intro={PROMPTING.lead} tone="panel">
  <ul class="grid gap-5 md:grid-cols-2">
    {
      PROMPTING.quotes.map((quote) => (
        <li>
          <figure class="flex h-full flex-col justify-between gap-4 rounded-xl border border-line bg-raised p-6">
            <blockquote class="text-lg leading-snug">“{quote.text}”</blockquote>
            <figcaption class="text-sm">
              <a href={quote.url} class="link" rel="noopener" target="_blank">
                {quote.source}
              </a>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <div class="mt-10 grid gap-6 lg:grid-cols-2 lg:gap-12">
    <p class="text-muted">
      {PROMPTING.research}{' '}
      <a href={PROMPTING.researchUrl} class="link" rel="noopener" target="_blank">Read the record</a>.
    </p>
    <p class="text-lg font-semibold">{PROMPTING.close}</p>
  </div>
</Section>
