---
import { PROMPTING } from '../config';
---

<div class="grid gap-6 border-t border-line pt-8 lg:grid-cols-12 lg:gap-12 lg:pt-10">
  <h3 class="text-h3 font-semibold lg:col-span-5">{PROMPTING.title}</h3>
  <div class="grid gap-5 lg:col-span-7 lg:gap-6">
    <ul class="grid gap-5 sm:grid-cols-2 sm:gap-6">
      {
        PROMPTING.quotes.map((quote) => (
          <li>
            <figure class="grid gap-2 border-l-2 border-line pl-4">
              <blockquote class="leading-snug sm:text-lg">“{quote.text}”</blockquote>
              <figcaption class="text-sm">
                <a href={quote.url} class="link" rel="noopener" target="_blank">
                  {quote.source}
                </a>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    <p class="text-sm text-muted">
      {PROMPTING.research}{' '}
      <a href={PROMPTING.researchUrl} class="link" rel="noopener" target="_blank">Read the record</a>.
    </p>
    <p class="font-semibold">{PROMPTING.close}</p>
  </div>
</div>
