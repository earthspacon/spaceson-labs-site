---
import { CONTACT_EMAIL, HERO } from '../config';
---

<section id="top" class="px-5 pt-12 pb-10 sm:px-8 lg:pt-16 lg:pb-12">
  <div class="mx-auto max-w-page">
    <h1 class="max-w-3xl text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl lg:text-[3.5rem]">
      {HERO.title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted sm:text-xl">{HERO.text}</p>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="rounded-md bg-ink px-5 py-3 font-semibold text-paper transition hover:bg-accent"
      >
        Email us
      </a>
      <a
        href="#products"
        class="rounded-md border border-line px-5 py-3 font-semibold transition hover:border-ink"
      >
        See the products
      </a>
      <p class="text-sm text-muted sm:ml-3">{HERO.location}</p>
    </div>
  </div>
</section>
