---
import { HERO, PRODUCTS } from '../config';
import ProductScreen from './ProductScreen.astro';

const [lead, ...rest] = PRODUCTS;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hero px-5 pt-6 pb-16 sm:px-8 sm:pt-14 lg:pt-20 lg:pb-24">
  <div class="mx-auto grid max-w-page grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
    <div class="lg:col-span-5">
      <h1 class="text-display font-semibold text-balance">{HERO.title}</h1>
      <p class="mt-4 max-w-xl text-base leading-normal text-muted sm:mt-6 sm:text-lg">{HERO.text}</p>

      <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
        <a href={`${base}#start`} class="btn btn-primary">{HERO.primary}</a>
        <a href={`${base}#check`} class="btn btn-ghost">{HERO.secondary}</a>
      </div>

      <p class="hero-anchor mt-5 text-sm text-muted">
        {HERO.anchor.text} <strong class="font-semibold text-ink">{HERO.anchor.price}</strong>
      </p>
    </div>

    <div class="lg:col-span-7">
      <p class="mb-3 text-sm text-muted">{HERO.workLabel}</p>
      <div class="work">
        <a href={lead.url} class="work-item work-lead" target="_blank" rel="noopener">
          <ProductScreen product={lead} sizes="(min-width: 1024px) 680px, 100vw" isEager />
          <p class="work-caption"><strong>{lead.name}</strong> <span>{lead.tagline}</span></p>
        </a>
        {
          rest.map((product) => (
            <a href={product.url} class="work-item" target="_blank" rel="noopener">
              <ProductScreen product={product} sizes="(min-width: 1024px) 340px, 50vw" />
              <p class="work-caption">
                <strong>{product.name}</strong> <span>{product.tagline}</span>
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }

  .work-lead {
    grid-column: 1 / -1;
  }

  .work-item {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .work-item :global(.screen) {
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .work-item:hover :global(.screen) {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .work-caption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .work-caption strong {
    font-weight: 600;
  }

  .work-caption span {
    color: var(--muted);
  }

  @media (max-width: 639px) {
    .work {
      gap: 1rem 0.75rem;
    }

    .work-caption span {
      display: block;
      font-size: 0.8125rem;
    }
  }
</style>
