---
import { HERO, HOW, PRODUCTS } from '../config';
import { icon } from '../lib/check-card';
import ProductScreen from './ProductScreen.astro';

const [lead, ...rest] = PRODUCTS;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hero px-5 pt-6 pb-16 sm:px-8 sm:pt-12 lg:pt-10 lg:pb-20">
  <div class="mx-auto grid max-w-page grid-cols-1 gap-10 lg:grid-cols-12 lg:grid-rows-[1fr_auto_auto_1fr] lg:gap-x-12 lg:gap-y-0">
    <div class="lg:col-span-5 lg:col-start-1 lg:row-start-2">
      <h1 class="text-display font-semibold text-balance">{HERO.title}</h1>
      <p class="mt-4 max-w-xl text-base leading-normal text-muted sm:mt-6 sm:text-lg">{HERO.text}</p>

      <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
        <a href={`${base}#start`} class="btn btn-primary">{HERO.primary}</a>
        <a href={`${base}#check`} class="btn btn-ghost">{HERO.secondary}</a>
      </div>

      <p class="hero-anchor mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
        <span>{HERO.anchor.text} <strong class="font-semibold text-ink">{HERO.anchor.price}</strong></span>
        <a href={`${base}#team`} class="link inline-flex items-center gap-1.5">{HERO.anchor.team}<Fragment set:html={icon('arrow')} /></a>
      </p>
    </div>

    <div id="products" class="scroll-mt-16 lg:col-span-7 lg:col-start-6 lg:row-span-4 lg:row-start-1">
      <p class="mb-3 text-sm text-muted">{HERO.workLabel}</p>
      <div class="work">
        <a href={lead.url} class="work-item work-lead" target="_blank" rel="noopener">
          <ProductScreen product={lead} sizes="(min-width: 1024px) 680px, 100vw" isEager hasPhone />
          <p class="work-caption">
            <strong>{lead.name}</strong> <span>{lead.tagline}</span> <span class="work-host">{lead.host}</span>
          </p>
        </a>
        {
          rest.map((product) => (
            <a href={product.url} class="work-item" target="_blank" rel="noopener">
              <ProductScreen product={product} sizes="(min-width: 1024px) 340px, 50vw" />
              <p class="work-caption">
                <strong>{product.name}</strong> <span>{product.tagline}</span> <span class="work-host">{product.host}</span>
              </p>
            </a>
          ))
        }
      </div>
    </div>

    <ul class="hero-terms grid grid-cols-2 gap-x-4 gap-y-2 border-t border-line pt-6 text-[0.8125rem] sm:text-sm lg:col-span-5 lg:col-start-1 lg:row-start-3 lg:mt-8">
      {
        HOW.steps.map((step) => (
          <li class="flex items-center gap-2">
            <span class="text-pass" set:html={icon('pass')} />
            {step.term}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .work-lead {
    grid-column: 1 / -1;
  }

  .work-item {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .work-item :global(.screen) {
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .work-item:hover :global(.screen) {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .work-caption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .work-caption strong {
    font-weight: 600;
  }

  .work-caption span {
    color: var(--muted);
  }

  .work-caption .work-host {
    display: block;
    margin-top: 0.15rem;
    color: var(--accent);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .work-item:hover .work-host {
    text-decoration: underline;
  }

</style>
