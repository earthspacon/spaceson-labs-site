---
const FACTS = [
  { value: '1–2 weeks', label: 'AI agent live in your stack' },
  { value: '3 weeks', label: 'MVP, fixed scope and price' },
  { value: 'Weekly', label: 'A working demo you can click' },
];
---

<section id="top" class="relative overflow-hidden px-5 pt-20 pb-20 sm:px-8 lg:pt-32 lg:pb-28">
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[720px] max-w-full -translate-x-1/2 rounded-full bg-accent/15 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-6xl">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3 py-1 text-xs text-muted sm:text-sm">
      <span class="size-1.5 rounded-full bg-accent"></span>
      AI-native product studio
    </p>
    <h1 class="mt-6 max-w-4xl font-display text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl">
      We ship AI agents, automations and MVPs in <span class="text-accent">weeks</span>, not quarters.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">
      For startups and small teams in the US, UK and EU. Fixed scope, fixed price, a working demo every week, and hours
      that overlap with yours.
    </p>
    <a
      href="#contact"
      class="mt-10 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 font-semibold text-accent-ink transition hover:brightness-110"
    >
      Get a fixed-price plan in 24 h
      <span aria-hidden="true">→</span>
    </a>
    <dl class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      {
        FACTS.map((fact) => (
          <div class="bg-ink px-6 py-5">
            <dt class="text-sm text-muted">{fact.label}</dt>
            <dd class="mt-1 font-display text-2xl font-semibold">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
