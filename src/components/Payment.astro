---
import { HOURS, PAYMENT_METHODS } from '../config';
import Section from './Section.astro';
---

<Section id="payment" title="Payment and hours" intro="Payment details come with each invoice.">
  <div class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      PAYMENT_METHODS.map((method) => (
        <div class="bg-paper p-6">
          <h3 class="font-semibold">{method.name}</h3>
          <p class="mt-1.5 text-sm text-muted">{method.text}</p>
        </div>
      ))
    }
    <div class="bg-panel p-6">
      <h3 class="font-semibold">{HOURS.title}</h3>
      <p class="mt-1.5 text-sm text-muted">{HOURS.text}</p>
    </div>
  </div>
</Section>
