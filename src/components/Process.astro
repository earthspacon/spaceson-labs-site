---
import { STEPS } from '../config';
import Section from './Section.astro';
---

<Section id="process" eyebrow="How we work" title="No hourly meter. No surprises.">
  <ol class="grid gap-5 md:grid-cols-3">
    {
      STEPS.map((step, index) => (
        <li class="rounded-2xl border border-line p-7">
          <span class="font-display text-sm font-semibold text-accent">0{index + 1}</span>
          <h3 class="mt-4 font-display text-xl font-semibold">{step.title}</h3>
          <p class="mt-3 text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
