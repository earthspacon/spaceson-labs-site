---
import { STEPS } from '../config';
import Section from './Section.astro';
---

<Section id="process" title="How a project runs" intro="Each step ends with something you can open and check.">
  <ol class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      STEPS.map((step, index) => (
        <li class="flex flex-col bg-paper p-6">
          <span class="font-mono text-sm text-accent">0{index + 1}</span>
          <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.text}</p>
          <p class="mt-auto pt-5 text-sm font-semibold">{step.artifact}</p>
        </li>
      ))
    }
  </ol>
</Section>
