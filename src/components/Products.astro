---
import { PRODUCTS, PRODUCTS_SECTION } from '../config';
import Section from './Section.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Section id="products" title={PRODUCTS_SECTION.title} intro={PRODUCTS_SECTION.intro} tone="panel">
  <div class="grid gap-5 md:grid-cols-3">
    {
      PRODUCTS.map((product) => (
        <a href={product.url} class="group flex flex-col overflow-hidden rounded-xl border border-line transition hover:border-ink">
          <div class="relative aspect-[16/11] border-b border-line bg-panel">
            <img
              src={`${base}${product.shot.src}`}
              alt={product.shot.alt}
              width={product.shot.width}
              height={product.shot.height}
              loading="lazy"
              decoding="async"
              class="absolute inset-3 h-[calc(100%-1.5rem)] w-[calc(100%-1.5rem)] object-contain object-top"
            />
          </div>
          <div class="grid gap-1 p-5">
            <h3 class="text-xl font-semibold">{product.name}</h3>
            <p class="text-muted">{product.job}</p>
            <span class="mt-1 text-sm break-all text-accent group-hover:underline">{product.host}</span>
          </div>
        </a>
      ))
    }
  </div>
</Section>
