---
import { HOW } from '../config';
import { icon } from '../lib/check-card';
import Section from './Section.astro';
---

<Section id="how" title={HOW.title} intro={HOW.intro}>
  <ol class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      HOW.steps.map((step) => (
        <li class="border-t-2 border-ink pt-4">
          <p class="font-mono text-xs tracking-wide text-muted uppercase">{step.when}</p>
          <h3 class="mt-2 text-xl font-semibold">{step.name}</h3>
          <p class="mt-2 text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
  <div class="mt-12 grid gap-6 border-t border-line pt-8 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h3 class="text-xl font-semibold">{HOW.team.title}</h3>
      <p class="mt-2 max-w-xl text-muted">{HOW.team.text}</p>
      <a href={HOW.team.url} class="link mt-3 inline-flex items-center gap-1.5" target="_blank" rel="noopener">
        {HOW.team.link}<Fragment set:html={icon('arrow')} />
      </a>
    </div>
    <div class="grid content-start gap-2 lg:col-span-5">
      <p class="font-semibold">{HOW.talk}</p>
      <p class="text-muted">{HOW.payment}</p>
    </div>
  </div>
</Section>
