---
import { WORK } from '../config';
import Section from './Section.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Section id="work" eyebrow="Work" title="Built by us, so you can see it before you buy.">
  <div class="space-y-5">
    {
      WORK.map((card) => (
        <article class="grid gap-10 overflow-hidden rounded-2xl border border-line bg-panel p-7 lg:grid-cols-2 lg:p-10">
          <div>
            <p class="inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">{card.label}</p>
            <h3 class="mt-4 font-display text-2xl font-semibold tracking-tight sm:text-3xl">{card.name}</h3>
            <p class="mt-4 text-muted">{card.summary}</p>
            <ul class="mt-6 space-y-2 text-sm text-white/85">
              {card.points.map((point) => (
                <li class="flex gap-3">
                  <span class="text-accent" aria-hidden="true">
                    ✓
                  </span>
                  {point}
                </li>
              ))}
            </ul>
            <a
              href={`${base}how-we-built/#${card.buildLogId}`}
              class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:text-white"
            >
              How it was built <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="grid auto-cols-fr grid-flow-col items-start gap-4">
            {card.shots.map((shot) => (
              <img
                src={`${base}${shot.src}`}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full rounded-xl border border-line"
              />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Section>
