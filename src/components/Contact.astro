---
import { CONTACT_EMAIL, STUDIO_NAME } from '../config';
---

<section id="contact" class="scroll-mt-20 px-5 pb-16 sm:px-8">
  <div class="mx-auto max-w-6xl rounded-3xl bg-accent px-7 py-14 text-accent-ink sm:px-12 lg:py-20">
    <h2 class="max-w-3xl font-display text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
      Tell us what you want to build.
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-accent-ink/75">
      A few lines are enough. Within 24 hours you get a one-page plan with scope, timeline and a fixed price.
    </p>
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="mt-8 inline-flex max-w-full items-center gap-2 rounded-full bg-accent-ink px-6 py-3.5 font-semibold break-all text-white transition hover:bg-black"
    >
      {CONTACT_EMAIL}
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <footer class="mx-auto mt-12 flex max-w-6xl flex-col gap-2 text-sm text-muted sm:flex-row sm:justify-between">
    <p>© {new Date().getFullYear()} {STUDIO_NAME}</p>
    <p>Tashkent, Uzbekistan · UTC+5</p>
  </footer>
</section>
