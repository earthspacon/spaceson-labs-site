---
import { CONTACT_EMAIL } from '../config';
---

<section id="contact" class="scroll-mt-16 px-5 pb-14 sm:px-8">
  <div class="mx-auto max-w-page rounded-lg bg-ink px-6 py-12 text-paper sm:px-10 lg:py-16">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Tell us what you want built.
    </h2>
    <p class="mt-3 max-w-2xl text-paper/70">
      A few lines are enough. Within 24 hours you get a one-page plan with scope, timeline and one fixed price.
    </p>
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="mt-8 inline-flex max-w-full items-center gap-2 rounded-md bg-paper px-5 py-3 font-semibold break-all text-ink transition hover:bg-accent hover:text-paper"
    >
      {CONTACT_EMAIL}
    </a>
  </div>
</section>
