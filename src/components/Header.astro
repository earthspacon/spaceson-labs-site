---
import { CONTACT_EMAIL, STUDIO_NAME } from '../config';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const LINKS = [
  { href: `${base}#products`, label: 'Products' },
  { href: `${base}#lately`, label: 'Lately' },
  { href: `${base}#services`, label: 'Services' },
  { href: `${base}#process`, label: 'Process' },
  { href: `${base}#faq`, label: 'FAQ' },
];
---

<header class="sticky top-0 z-10 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-page items-center justify-between gap-6 px-5 sm:px-8">
    <a href={base} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <Logo />
      {STUDIO_NAME}
    </a>
    <nav class="hidden items-center gap-7 text-sm text-muted md:flex" aria-label="Main">
      {LINKS.map((link) => <a href={link.href} class="transition hover:text-ink">{link.label}</a>)}
    </nav>
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="rounded-md bg-ink px-3.5 py-1.5 text-sm font-semibold text-paper transition hover:bg-accent"
    >
      Email us
    </a>
  </div>
</header>
