---
import { STUDIO_NAME } from '../config';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const LINKS = [
  { href: `${base}#services`, label: 'Services' },
  { href: `${base}#process`, label: 'Process' },
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#faq`, label: 'FAQ' },
];
---

<header class="sticky top-0 z-10 border-b border-line/60 bg-ink/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href={base} class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
      <Logo />
      {STUDIO_NAME}
    </a>
    <nav class="hidden items-center gap-8 text-sm text-muted md:flex" aria-label="Main">
      {LINKS.map((link) => <a href={link.href} class="transition hover:text-white">{link.label}</a>)}
    </nav>
    <a
      href={`${base}#contact`}
      class="rounded-full border border-line px-4 py-2 text-sm font-medium transition hover:border-accent hover:text-accent"
    >
      Get a plan
    </a>
  </div>
</header>
