---
import { HERO, NAV_LINKS, STUDIO_NAME } from '../config';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="sticky top-0 z-10 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-page items-center justify-between gap-6 px-5 sm:px-8">
    <a href={base} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <Logo />
      {STUDIO_NAME}
    </a>
    <nav class="hidden items-center gap-7 text-sm text-muted lg:flex" aria-label="Main">
      {NAV_LINKS.map((link) => <a href={`${base}${link.href}`} class="transition hover:text-ink">{link.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href={`${base}#start`}
        class="rounded-md bg-ink px-3.5 py-1.5 text-sm font-semibold whitespace-nowrap text-paper transition hover:bg-accent"
      >
        {HERO.primary}
      </a>
    </div>
  </div>
</header>
