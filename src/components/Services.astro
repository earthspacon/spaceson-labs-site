---
import { SERVICES, SERVICES_ALSO } from '../config';
import Section from './Section.astro';
---

<Section id="services" title="Work with us" intro="Three packages. The price is where each one starts.">
  <div class="grid gap-5 lg:grid-cols-3">
    {
      SERVICES.map((service) => (
        <article class="flex flex-col rounded-lg border border-line p-6">
          <p class="text-sm text-muted">{service.timeline}</p>
          <h3 class="mt-1 text-xl font-semibold tracking-tight">{service.name}</h3>
          <p class="mt-2 text-muted">{service.summary}</p>
          <p class="mt-5 text-3xl font-semibold tracking-tight">{service.price}</p>
          <p class="mt-1 text-sm text-muted">{service.priceNote}</p>
          <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm">
            {service.includes.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 size-1 shrink-0 bg-accent" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
  <p class="mt-6 text-sm text-muted">{SERVICES_ALSO}</p>
</Section>
