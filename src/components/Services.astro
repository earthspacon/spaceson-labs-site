---
import { SERVICES, SERVICES_NOTE } from '../config';
import Section from './Section.astro';
---

<Section id="work" title="What we take on" intro={SERVICES_NOTE}>
  <ul class="border-t border-line">
    {
      SERVICES.map((service) => (
        <li class="grid gap-1 border-b border-line py-6 sm:grid-cols-12 sm:items-baseline sm:gap-8">
          <h3 class="text-xl font-semibold tracking-tight sm:col-span-4">{service.name}</h3>
          <p class="text-muted sm:col-span-5">{service.text}</p>
          <p class="text-lg font-semibold sm:col-span-3 sm:text-right">{service.price}</p>
        </li>
      ))
    }
  </ul>
</Section>
