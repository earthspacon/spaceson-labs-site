---
import { BREAKS } from '../config';
import Section from './Section.astro';
---

<Section id="breaks" title={BREAKS.title}>
  <figure class="grid gap-3 border-l-2 border-accent pl-5 lg:max-w-3xl">
    <blockquote class="text-2xl leading-snug font-semibold tracking-tight sm:text-3xl">{BREAKS.quote}</blockquote>
    <figcaption class="text-sm text-muted">
      <a href={BREAKS.quoteUrl} class="link" rel="noopener" target="_blank">{BREAKS.quoteSource}</a>
    </figcaption>
  </figure>
  <p class="mt-6 max-w-2xl text-muted">{BREAKS.quoteAfter}</p>

  <ul class="mt-12 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
    {
      BREAKS.items.map((item) => (
        <li class="grid content-start gap-2 border-r border-b border-line p-6">
          <h3 class="text-xl font-semibold">{item.problem}</h3>
          <p class="text-muted">{item.text}</p>
          <p class="mt-2 text-sm">
            <span class="font-semibold text-pass">Fix:</span> {item.fix}
          </p>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-sm text-muted">{BREAKS.footnote}</p>
</Section>
