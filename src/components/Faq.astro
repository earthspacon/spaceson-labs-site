---
import { FAQ } from '../config';
import Section from './Section.astro';
---

<Section id="faq" title="Questions">
  <div class="divide-y divide-line border-y border-line">
    {
      FAQ.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold [&::-webkit-details-marker]:hidden">
            {item.question}
            <span class="shrink-0 text-xl text-muted transition group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-3 max-w-3xl text-muted">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
