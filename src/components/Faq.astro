---
import { FAQ } from '../config';
import Section from './Section.astro';
---

<Section id="faq" eyebrow="FAQ" title="Questions people ask first.">
  <div class="divide-y divide-line border-y border-line">
    {
      FAQ.map((item) => (
        <details class="group py-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-medium [&::-webkit-details-marker]:hidden">
            {item.question}
            <span class="shrink-0 text-2xl text-accent transition group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-4 max-w-3xl text-muted">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
