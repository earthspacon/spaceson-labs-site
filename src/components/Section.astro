---
type Props = {
  id: string;
  eyebrow: string;
  title: string;
};

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-line px-5 py-20 sm:px-8 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-medium tracking-widest text-accent uppercase">{eyebrow}</p>
    <h2 class="mt-3 max-w-3xl font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">
      {title}
    </h2>
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
