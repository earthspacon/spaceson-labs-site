---
type Props = {
  id: string;
  title: string;
  intro?: string;
};

const { id, title, intro } = Astro.props;
---

<section id={id} class="scroll-mt-16 border-t border-line px-5 py-14 sm:px-8 lg:py-20">
  <div class="mx-auto max-w-page">
    <div class="flex flex-col gap-2 lg:flex-row lg:items-baseline lg:justify-between lg:gap-10">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
      {intro && <p class="max-w-md text-muted lg:text-right">{intro}</p>}
    </div>
    <div class="mt-8 lg:mt-10">
      <slot />
    </div>
  </div>
</section>
