---
import { OFFER } from '../config';
import sampleLive from '../data/sample-check-live.json';
import { type CheckResult, icon, renderCheckCard } from '../lib/check-card';
import Section from './Section.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Section id="check" title={OFFER.title} tone="panel">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="grid content-start gap-8 lg:col-span-6">
      <div>
        <h3 class="text-xl font-semibold">{OFFER.check.name}</h3>
        <p class="mt-2 text-muted">{OFFER.check.text}</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">{OFFER.fix.name}</h3>
        <ul class="mt-3 grid gap-3">
          {
            OFFER.fix.items.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 text-accent" set:html={icon('arrow')} />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href={`${base}#start`} class="btn btn-primary">{OFFER.cta}<Fragment set:html={icon('arrow')} /></a>
        <a href={`${base}#sample`} class="link">See a sample audit</a>
      </div>
    </div>
    <figure class="lg:col-span-6">
      <figcaption class="mb-2 text-sm text-muted">{OFFER.sampleCaption}</figcaption>
      <Fragment set:html={renderCheckCard({ result: sampleLive as CheckResult, isSample: true })} />
      <p class="mt-4 text-sm text-muted">{OFFER.repoPrompt}</p>
    </figure>
  </div>
</Section>
