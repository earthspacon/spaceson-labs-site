---
import type { Product } from '../config';

type Props = {
  product: Product;
  sizes: string;
  isEager?: boolean;
  // Below 640 px, swap in the crop taken at phone width so the text stays readable.
  hasPhone?: boolean;
};

const SCREEN_WIDTH = 1040;
const SCREEN_HEIGHT = 520;
const PHONE_WIDTH = 480;
const PHONE_HEIGHT = 600;
const THEMES = ['dark', 'light'] as const;

const { product, sizes, isEager = false, hasPhone = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<figure class="screen">
  <div class="screen-bar" aria-hidden="true">
    <span class="screen-dots"><i></i><i></i><i></i></span>
    <span class="screen-host">{product.host}</span>
  </div>
  {
    THEMES.map((theme) => {
      const file = `${base}work/hero-${product.slug}`;
      return (
        <picture class={`only-${theme}`}>
          {hasPhone && (
            <source
              media="(max-width: 639px)"
              srcset={`${file}-phone-${theme}.webp ${PHONE_WIDTH}w, ${file}-phone-${theme}@2x.webp ${PHONE_WIDTH * 2}w`}
              sizes="100vw"
              width={PHONE_WIDTH}
              height={PHONE_HEIGHT}
            />
          )}
          <img
            class="screen-img"
            src={`${file}-${theme}.webp`}
            srcset={`${file}-${theme}.webp ${SCREEN_WIDTH}w, ${file}-${theme}@2x.webp ${SCREEN_WIDTH * 2}w`}
            sizes={sizes}
            alt={product.alt}
            width={SCREEN_WIDTH}
            height={SCREEN_HEIGHT}
            loading={isEager ? 'eager' : 'lazy'}
            decoding="async"
          />
        </picture>
      );
    })
  }
</figure>

<style>
  .screen {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--raised);
    box-shadow: var(--shadow);
  }

  .screen-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 1.75rem;
    padding: 0 0.7rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .screen-dots {
    display: flex;
    gap: 0.3rem;
  }

  .screen-dots i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--line);
  }

  .screen-host {
    overflow: hidden;
    font-size: 0.7rem;
    color: var(--muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .screen-img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
