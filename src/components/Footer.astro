---
import { CONTACT_EMAIL, STUDIO_NAME } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="border-t border-line px-5 py-10 sm:px-8">
  <div class="mx-auto flex max-w-page flex-col gap-2 text-sm text-muted sm:flex-row sm:justify-between">
    <p>{STUDIO_NAME}</p>
    <p class="flex flex-wrap gap-x-5 gap-y-1">
      <a href={`${base}check`} class="hover:text-ink">Free app check</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-ink">{CONTACT_EMAIL}</a>
    </p>
  </div>
</footer>
