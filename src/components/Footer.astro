---
import { CONTACT_EMAIL, HERO, STUDIO_NAME } from '../config';
---

<footer class="px-5 pb-12 sm:px-8">
  <div class="mx-auto flex max-w-page flex-col gap-2 text-sm text-muted lg:flex-row lg:justify-between">
    <p>© {new Date().getFullYear()} {STUDIO_NAME}</p>
    <p>{HERO.location} · <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-ink">{CONTACT_EMAIL}</a></p>
  </div>
</footer>
