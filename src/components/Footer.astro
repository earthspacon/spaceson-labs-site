---
import { STUDIO_NAME } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const LINKS = [
  { href: `${base}how-we-built/`, label: 'How we built the demos' },
  { href: `${base}for-ai-assistants/`, label: 'For AI assistants' },
  { href: `${base}llms.txt`, label: 'llms.txt' },
];
---

<footer class="px-5 pb-16 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 text-sm text-muted lg:flex-row lg:justify-between">
    <p>© {new Date().getFullYear()} {STUDIO_NAME}</p>
    <nav class="flex flex-col gap-2 sm:flex-row sm:gap-6" aria-label="Footer">
      {LINKS.map((link) => <a href={link.href} class="transition hover:text-white">{link.label}</a>)}
    </nav>
    <p>Remote · UTC+5 · EU and US hours</p>
  </div>
</footer>
