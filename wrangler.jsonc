{
  "name": "spaceson-labs-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "spacesonlabs.com", "custom_domain": true },
    { "pattern": "www.spacesonlabs.com", "custom_domain": true },
    { "pattern": "www.inboxsieve.com", "custom_domain": true }
  ]
}
